<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_10sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mc_version_spinner">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/endercore_brand_icon"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:contentDescription="EnderCore Client"
                android:src="@drawable/omni_launcher_foreground"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/omni_brand_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_9sdp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.025"
                android:text="EnderCore"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_20ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/endercore_brand_icon"
                app:layout_constraintTop_toTopOf="@id/endercore_brand_icon"
                app:layout_constraintEnd_toStartOf="@id/omni_settings_button" />

            <TextView
                android:id="@+id/omni_brand_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_9sdp"
                android:text="CLIENT  ·  JAVA EDITION"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/_9ssp"
                android:letterSpacing="0.10"
                app:layout_constraintStart_toEndOf="@id/endercore_brand_icon"
                app:layout_constraintTop_toBottomOf="@id/omni_brand_title"
                app:layout_constraintEnd_toStartOf="@id/omni_settings_button" />

            <ImageButton
                android:id="@+id/omni_settings_button"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="@drawable/omni_menu_card"
                android:contentDescription="Ajustes"
                android:src="@drawable/ic_menu_settings"
                android:padding="@dimen/_10sdp"
                app:tint="@color/primary_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/endercore_hero_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/omni_menu_card"
                android:minHeight="@dimen/_132sdp"
                android:padding="@dimen/_14sdp"
                app:layout_constraintTop_toBottomOf="@id/endercore_brand_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/endercore_hero_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENDERCORE CLIENT"
                    android:textColor="@color/omni_accent"
                    android:textSize="@dimen/_9ssp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/endercore_hero_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="Juega sin límites"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_22ssp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/endercore_hero_eyebrow"
                    app:layout_constraintEnd_toStartOf="@id/endercore_hero_logo" />

                <TextView
                    android:id="@+id/endercore_hero_caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="Tu mundo, en tus manos."
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/endercore_hero_title"
                    app:layout_constraintEnd_toStartOf="@id/endercore_hero_logo"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/endercore_hero_logo"
                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="@dimen/_70sdp"
                    android:contentDescription="Logo EnderCore"
                    android:src="@drawable/omni_launcher_foreground"
                    android:scaleType="fitCenter"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <View
                    android:id="@+id/omni_hero_divider"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@color/omni_accent"
                    app:layout_constraintTop_toBottomOf="@id/endercore_hero_caption"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:ignore="NotSibling" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/endercore_quick_actions_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="Acceso rápido"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/endercore_hero_card" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/mcl_tab_wiki"
                android:drawableStart="@drawable/ic_menu_news"
                app:layout_constraintTop_toBottomOf="@id/endercore_quick_actions_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/social_divider" />

            <View
                android:id="@+id/social_divider"
                style="@style/LauncherFragment_Divider"
                android:layout_width="@dimen/_1sdp"
                android:layout_height="@dimen/_28sdp"
                app:layout_constraintTop_toTopOf="@id/news_button"
                app:layout_constraintStart_toStartOf="@id/center_guideline"
                app:layout_constraintEnd_toEndOf="@id/center_guideline"
                app:layout_constraintBottom_toBottomOf="@id/news_button" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/center_guideline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/discord_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/mcl_button_discord"
                android:drawableStart="@drawable/ic_discord"
                app:layout_constraintTop_toBottomOf="@id/endercore_quick_actions_title"
                app:layout_constraintStart_toEndOf="@id/social_divider"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_7sdp"
                android:drawableStart="@drawable/ic_menu_custom_controls"
                android:text="@string/mcl_option_customcontrol"
                app:layout_constraintTop_toBottomOf="@id/news_button" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_7sdp"
                android:drawableStart="@drawable/ic_menu_install_jar"
                android:text="@string/main_install_jar_file"
                app:layout_constraintTop_toBottomOf="@id/custom_control_button" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_7sdp"
                android:drawableStart="@android:drawable/ic_menu_share"
                android:text="@string/main_share_logs"
                app:layout_constraintTop_toBottomOf="@id/install_jar_button" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_7sdp"
                android:text="@string/mcl_button_open_directory"
                android:drawableStart="@drawable/ic_folder"
                app:layout_constraintTop_toBottomOf="@id/share_logs_button" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="0dp"
        android:layout_height="@dimen/_52sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:background="@drawable/omni_version_card"
        android:drawableEnd="@drawable/spinner_arrow"
        app:drawableEndSize="@dimen/padding_heavy"
        app:drawableStartIntegerScaling="true"
        app:drawableStartSize="@dimen/_36sdp"
        app:drawableEndPadding="@dimen/_1sdp"
        app:layout_constraintBottom_toTopOf="@id/play_button"
        app:layout_constraintEnd_toStartOf="@+id/edit_profile_button"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="@dimen/_52sdp"
        android:layout_height="@dimen/_52sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/omni_menu_card"
        android:contentDescription="Editar perfil seleccionado"
        android:src="@drawable/ic_edit_profile"
        app:tint="@color/primary_text"
        app:layout_constraintBottom_toBottomOf="@+id/mc_version_spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mc_version_spinner" />

    <View
        android:id="@+id/_background_display_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/background_bottom_bar"
        android:translationZ="-1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_62sdp"
        android:layout_marginHorizontal="@dimen/_17sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:textAllCaps="false"
        android:text="▶  INICIAR JUEGO"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
